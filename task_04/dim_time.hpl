  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    LEAST(
		(SELECT MIN(year) FROM staging_maddison), 
		(SELECT MIN(year) FROM staging_wdi)
	) AS StartYear,
    GREATEST(
		(SELECT MAX(year) FROM staging_maddison),
		(SELECT MAX(year) FROM staging_wdi)
	) AS EndYear</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
